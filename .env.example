# =============================================================================
# Milkly Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# Required variables are marked with (required)
# =============================================================================

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
# BACKEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database - PostgreSQL (required)
# -----------------------------------------------------------------------------
# For local development with Docker:
DATABASE_URL="postgresql://milkly:milkly_dev@localhost:5432/milkly"
# For local development without Docker (if running PostgreSQL directly):
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/milkly"

# -----------------------------------------------------------------------------
# Redis (optional)
# -----------------------------------------------------------------------------
# Redis is used for rate limiting and caching
# If not configured, those features will be disabled
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Authentication (required)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here

# -----------------------------------------------------------------------------
# AI Services - Dual Model Support
# -----------------------------------------------------------------------------
# Milkly supports separate AI configurations for different task complexities:
# - High-end model: Complex tasks (template generation, full content generation)
# - Low-end model: Simple tasks (notes, keywords, block regeneration)
#
# If high/low configs not set, falls back to base AI_PROVIDER/AI_MODEL

# AI Provider Configuration - High-end model (complex tasks)
# Supported providers: anthropic, openai, google
AI_HIGH_PROVIDER=google
AI_HIGH_MODEL=gemini-2.5-flash
# AI_HIGH_API_KEY=your-api-key  # Optional, falls back to GOOGLE_API_KEY

# AI Provider Configuration - Low-end model (simple tasks)
AI_LOW_PROVIDER=google
AI_LOW_MODEL=gemini-2.5-flash
# AI_LOW_API_KEY=your-api-key  # Optional, falls back to GOOGLE_API_KEY

# AI Provider Configuration - Base/Fallback (used if high/low not specified)
# Supported providers: anthropic, openai, google
AI_PROVIDER=google
AI_MODEL=gemini-2.5-flash
# AI_API_KEY=your-api-key  # Optional, falls back to provider-specific key

# AI Temperature (0.0 - 2.0, default: 1.2)
# Lower = more deterministic, Higher = more creative
AI_TEMPERATURE=0.7

# Custom AI Endpoint (optional - overrides default provider endpoint)
# AI_ENDPOINT=https://your-custom-endpoint.com/v1

# -----------------------------------------------------------------------------
# AI API Keys (provider-specific)
# -----------------------------------------------------------------------------
# These keys are used when AI_HIGH_API_KEY/AI_LOW_API_KEY/AI_API_KEY not set

# Google Gemini - https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key
# GEMINI_API_KEY=your-gemini-api-key  # Alternative name

# OpenAI - https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic - https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -----------------------------------------------------------------------------
# Content APIs
# -----------------------------------------------------------------------------
# News API - https://newsapi.org/
NEWS_API_KEY=your-newsapi-key
NEWS_API_BASE_URL=https://newsapi.org/v2

# YouTube Data API - https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

# SociaVault API - https://sociavault.com
# Provides real social media content (Twitter/X, Reddit, Threads)
# Credit-based pricing: 1 credit per request (most endpoints)
# If not configured, falls back to mock social data
SOCIAVAULT_API_KEY=sk_live_your-sociavault-api-key
# SOCIAVAULT_API_BASE_URL=https://api.sociavault.com/v1/scrape  # optional, has default

# -----------------------------------------------------------------------------
# Payment Provider - Stripe
# -----------------------------------------------------------------------------
# Get your keys at: https://dashboard.stripe.com/apikeys
PAYMENT_PROVIDER=stripe

# Stripe API Keys
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Stripe Price IDs (create products/prices in Stripe Dashboard)
# https://dashboard.stripe.com/products
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_xxx
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=price_xxx
STRIPE_MASTERY_MONTHLY_PRICE_ID=price_xxx
STRIPE_MASTERY_YEARLY_PRICE_ID=price_xxx

# -----------------------------------------------------------------------------
# Email Provider - Resend
# -----------------------------------------------------------------------------
# Get your key at: https://resend.com/api-keys
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL="Milkly <noreply@yourdomain.com>"

# Alternative: Loops.so (not yet implemented)
# EMAIL_PROVIDER=loops
# LOOPS_API_KEY=your-loops-api-key
# LOOPS_FROM_EMAIL="Milkly <noreply@yourdomain.com>"

# Alternative: AWS SES - https://aws.amazon.com/ses/
# EMAIL_PROVIDER=ses
# SES_ACCESS_KEY_ID=your-ses-access-key
# SES_SECRET_ACCESS_KEY=your-ses-secret-key
# SES_REGION=us-east-1
# SES_FROM_EMAIL="Milkly <newsletter@milkly.email>"
# SES_CONFIGURATION_SET=milkly-newsletter  # optional, for open/click tracking

# -----------------------------------------------------------------------------
# Application URLs
# -----------------------------------------------------------------------------
# Public URL for newsletter unsubscribe links
MILKLY_NEWS_URL=https://milkly.news

# -----------------------------------------------------------------------------
# Storage Provider - S3 (optional)
# -----------------------------------------------------------------------------
# S3-compatible storage for media uploads (images, logos, etc.)
# If not configured, the app works without media upload functionality
# and users can still use external image URLs instead.

# Required for S3 uploads:
# S3_BUCKET=your-bucket-name
# S3_ACCESS_KEY_ID=your-access-key
# S3_SECRET_ACCESS_KEY=your-secret-key

# Optional S3 settings:
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.your-region.amazonaws.com  # For S3-compatible services (R2, MinIO, etc.)
# S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com     # CDN URL for public assets

# -----------------------------------------------------------------------------
# Development Mode
# -----------------------------------------------------------------------------
# Set to "true" to enable dev features like tier switching without payment
DEV_MODE=true

# -----------------------------------------------------------------------------
# Pagination (optional - has defaults)
# -----------------------------------------------------------------------------
# PAGINATION_STREAMS_DEFAULT=20
# PAGINATION_STREAMS_MAX=50
# PAGINATION_FEED_DEFAULT=20
# PAGINATION_FEED_MAX=100
# PAGINATION_NEWSLETTERS_DEFAULT=10
# PAGINATION_NEWSLETTERS_MAX=50
# PAGINATION_TEMPLATES_DEFAULT=10
# PAGINATION_TEMPLATES_MAX=20
